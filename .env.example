# Configure privately. Never copy a real .env into a handoff or commit.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DEMO_IDENTITY_ENABLED=false
ASSISTANT_MODE=simulated
DEMO_DIAGNOSTICS=false

# Direct OpenAI (use only with a key issued by OpenAI Platform):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# GW/Azure alternative. Change ASSISTANT_MODE to azure and fill these privately.
# GW_AZURE_OPENAI_KEY=YOUR_AZURE_KEY
# GW_AZURE_RESOURCE=YOUR_RESOURCE_NAME
# GW_AZURE_MODEL=YOUR_DEPLOYMENT_NAME
# Or use AZURE_OPENAI_API_KEY, AZURE_OPENAI_ENDPOINT and AZURE_OPENAI_DEPLOYMENT.
# AZURE_OPENAI_ENDPOINT must be the HTTPS resource root, not /openai/v1/.
# AZURE_OPENAI_API_VERSION=2025-03-01-preview
# Optional for a compatible Azure reasoning deployment (current GW model uses none):
# AZURE_OPENAI_REASONING_EFFORT=none
